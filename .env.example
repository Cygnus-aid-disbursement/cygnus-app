# Copy to .env.local for local development.

# Point the app at a specific deployment file instead of the SDK's vendored one.
# A contract developer running a local Testnet deploy sets this to their
# contracts repo's deployments/local-testnet.json.
CONSTELLATION_DEPLOYMENTS=

# Public Soroban RPC URL. Defaults to the public Testnet RPC.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# A funded Testnet account used only to simulate read-only contract calls on the
# server. No signing happens with it. Any existing Testnet account works.
READER_PUBLIC_KEY=
