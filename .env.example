# Copy to .env.local for local development. Every value here has a working
# default except NODE_AUTH_TOKEN, which is only needed to install the SDK.

# Token with read:packages, used only by the package manager to install
# @cygnus-aid-disbursement/sdk from GitHub Packages. Not read at runtime.
NODE_AUTH_TOKEN=

# Point the app at a specific deployment file instead of the SDK's vendored one.
# A contract developer running a local Testnet deploy sets this to their contracts
# repo's deployments/local-testnet.json. Server-side only.
CYGNUS_DEPLOYMENTS=

# Soroban RPC URL. Defaults to the public Testnet RPC. Read by both the server
# and the browser.
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Funded Testnet account used only to simulate read-only contract calls on the
# server. No signing happens with it. Any existing Testnet account works.
READER_PUBLIC_KEY=

# Same as READER_PUBLIC_KEY but for read-only simulation from the browser, used by
# the verify page. No signing happens with it.
NEXT_PUBLIC_READER_PUBLIC_KEY=

# Override the programme contract id in the browser. Defaults to the id the SDK
# vendors, so you normally leave this unset.
NEXT_PUBLIC_CONTRACT_ID=
